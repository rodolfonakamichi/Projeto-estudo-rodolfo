# Valores padrão (versionados) — servem para dev e para o docker-compose.
# Sobrescritas locais: .env.local (fora do git). Real env vars vencem os arquivos.
# NUNCA colocar segredo de produção aqui: https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

# Banco — lidas pelo docker-compose (serviço db) e pelo DATABASE_URL abaixo
DB_HOST=db
DB_PORT=3306
DB_DATABASE=comandas
DB_USERNAME=comandas
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

DATABASE_URL="mysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?serverVersion=8.4.0&charset=utf8mb4"

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
