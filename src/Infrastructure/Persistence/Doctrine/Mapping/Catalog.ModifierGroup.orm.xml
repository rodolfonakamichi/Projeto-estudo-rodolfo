<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- sem is_required: obrigatório = min_select >= 1 (derivado, uma fonte só) -->
    <entity name="App\Domain\Catalog\ModifierGroup" table="modifier_groups">
        <unique-constraints>
            <unique-constraint name="uniq_modifier_groups_name" columns="product_id,name"/>
        </unique-constraints>

        <id name="id" type="modifier_group_id"/>

        <field name="name" length="80"/>
        <field name="minSelect" column="min_select" type="integer"/>
        <field name="maxSelect" column="max_select" type="integer"/>
        <field name="sortOrder" column="sort_order" type="integer"/>

        <many-to-one field="product" target-entity="App\Domain\Catalog\Product" inversed-by="modifierGroups">
            <join-column name="product_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <one-to-many field="modifiers" target-entity="App\Domain\Catalog\Modifier" mapped-by="group" orphan-removal="true">
            <cascade><cascade-persist/></cascade>
            <order-by><order-by-field name="sortOrder"/></order-by>
        </one-to-many>
    </entity>
</doctrine-mapping>
