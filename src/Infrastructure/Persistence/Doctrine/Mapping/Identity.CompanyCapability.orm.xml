<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Identity\CompanyCapability" table="company_capabilities">
        <unique-constraints>
            <unique-constraint name="uniq_company_capabilities" columns="company_id,capability"/>
        </unique-constraints>

        <id name="id" type="company_capability_id"/>

        <field name="capability" length="40" enum-type="App\Domain\Identity\Capability"/>
        <field name="enabled" type="boolean"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>

        <many-to-one field="company" target-entity="App\Domain\Identity\Company" inversed-by="capabilities">
            <join-column name="company_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
