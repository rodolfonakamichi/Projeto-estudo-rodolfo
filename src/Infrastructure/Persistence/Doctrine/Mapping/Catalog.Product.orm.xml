<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- doc 03 §2. Raiz do agregado: variações e grupos vão em cascata (persist + orphan-removal).
         Categoria/estação/empresa/filial por ID: as FKs vêm do IdentifierForeignKeys -->
    <entity name="App\Domain\Catalog\Product" table="products">
        <indexes>
            <index name="idx_products_branch_active" columns="branch_id,is_active"/>
        </indexes>

        <id name="id" type="product_id"/>

        <field name="companyId" column="company_id" type="company_id"/>
        <field name="branchId" column="branch_id" type="branch_id"/>
        <field name="categoryId" column="category_id" type="category_id" nullable="true"/>
        <field name="stationId" column="station_id" type="station_id" nullable="true"/>
        <field name="name" length="150"/>
        <field name="kind" length="20" enum-type="App\Domain\Catalog\ProductKind"/>
        <field name="trackStock" column="track_stock" type="boolean"/>
        <field name="active" column="is_active" type="boolean"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>

        <one-to-many field="variants" target-entity="App\Domain\Catalog\ProductVariant" mapped-by="product" orphan-removal="true">
            <cascade><cascade-persist/></cascade>
            <order-by><order-by-field name="sortOrder"/></order-by>
        </one-to-many>
        <one-to-many field="modifierGroups" target-entity="App\Domain\Catalog\ModifierGroup" mapped-by="product" orphan-removal="true">
            <cascade><cascade-persist/></cascade>
            <order-by><order-by-field name="sortOrder"/></order-by>
        </one-to-many>
    </entity>
</doctrine-mapping>
