<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- PK composta (role_id, permission), como no doc 03 -->
    <entity name="App\Domain\Identity\RolePermission" table="role_permissions">
        <id name="role" association-key="true"/>
        <id name="permission" type="string" length="60"/>

        <many-to-one field="role" target-entity="App\Domain\Identity\Role" inversed-by="permissions">
            <join-column name="role_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
