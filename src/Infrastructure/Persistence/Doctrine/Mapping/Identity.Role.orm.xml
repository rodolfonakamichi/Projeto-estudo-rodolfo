<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Identity\Role" table="roles">
        <unique-constraints>
            <unique-constraint name="uniq_roles_company_code" columns="company_id,code"/>
        </unique-constraints>

        <id name="id" type="role_id"/>

        <field name="code" type="role_code"/>
        <field name="name" length="80"/>
        <!-- doc 06 §4: limite de desconto do papel; NULL = sem limite -->
        <field name="maxDiscount" column="max_discount_percent" type="percentage" precision="5" scale="2" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>

        <many-to-one field="company" target-entity="App\Domain\Identity\Company">
            <join-column name="company_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <!-- orphan-removal: revoke() tira da coleção => DELETE da linha -->
        <one-to-many field="permissions" target-entity="App\Domain\Identity\RolePermission" mapped-by="role" orphan-removal="true">
            <cascade><cascade-persist/></cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
