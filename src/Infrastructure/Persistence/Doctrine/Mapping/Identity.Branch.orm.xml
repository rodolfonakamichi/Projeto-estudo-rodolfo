<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Identity\Branch" table="branches">
        <unique-constraints>
            <unique-constraint name="uniq_branches_company_name" columns="company_id,name"/>
        </unique-constraints>

        <id name="id" type="branch_id"/>

        <field name="name" length="150"/>
        <field name="timezone" length="40"/>
        <field name="status" length="30" enum-type="App\Domain\Identity\BranchStatus"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>

        <many-to-one field="company" target-entity="App\Domain\Identity\Company" inversed-by="branches">
            <join-column name="company_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
