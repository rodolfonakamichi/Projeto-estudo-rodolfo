{
  "name": "rodolfonakamichi/comandas-universal",
  "description": "Plataforma Universal de Comandas — projeto de estudo (PHP 8.3, sem framework).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "nikic/fast-route": "^1.3",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "php-di/php-di": "^7.1",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "robmorgan/phinx": "^0.16.12",
    "symfony/console": "^7.4",
    "symfony/uid": "^7.4",
    "vlucas/phpdotenv": "^5.7"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
